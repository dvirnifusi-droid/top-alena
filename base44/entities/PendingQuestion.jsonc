{
  "name": "PendingQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d0\u05dc\u05d4 \u05e9\u05d3\u05d1\u05d9\u05e8 \u05dc\u05d0 \u05d4\u05e6\u05dc\u05d9\u05d7 \u05dc\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc\u05d9\u05d4"
    },
    "asked_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e9\u05d0\u05dc \u05d0\u05ea \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "context": {
      "type": "string",
      "description": "\u05d4\u05e7\u05e9\u05e8 \u05e0\u05d5\u05e1\u05e3 \u05dc\u05e9\u05d0\u05dc\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "processed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "admin_answer": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e9\u05d4\u05de\u05e0\u05d4\u05dc \u05e0\u05ea\u05df"
    },
    "whatsapp_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d4\u05d5\u05d3\u05e2\u05ea \u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4"
    },
    "knowledge_base_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05e9\u05e0\u05d5\u05e6\u05e8\u05d4 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d9\u05d3\u05e2"
    }
  },
  "required": [
    "question",
    "asked_by"
  ]
}