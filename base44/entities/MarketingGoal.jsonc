{
  "name": "MarketingGoal",
  "type": "object",
  "properties": {
    "goal_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d9\u05e2\u05d3"
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "sales_increase",
        "customer_acquisition",
        "brand_awareness",
        "social_engagement",
        "repeat_customers",
        "average_order_value",
        "online_presence",
        "review_score"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d9\u05e2\u05d3"
    },
    "target_value": {
      "type": "number",
      "description": "\u05d4\u05e2\u05e8\u05da \u05d4\u05de\u05d8\u05e8\u05d4"
    },
    "current_value": {
      "type": "number",
      "description": "\u05d4\u05e2\u05e8\u05da \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "measurement_unit": {
      "type": "string",
      "enum": [
        "percentage",
        "absolute_number",
        "money",
        "rating"
      ],
      "description": "\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d9\u05d3\u05d4"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "achieved",
        "failed",
        "paused"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d9\u05e2\u05d3"
    },
    "progress_percentage": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea"
    },
    "related_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05d9\u05e2\u05d3"
    },
    "success_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05e6\u05dc\u05d7\u05d4 \u05de\u05d6\u05d5\u05d4\u05d9\u05dd"
    }
  },
  "required": [
    "goal_name",
    "goal_type",
    "target_value",
    "target_date"
  ]
}