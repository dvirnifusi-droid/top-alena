{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05de\u05e0\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e0\u05d4"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8"
    },
    "is_recommended": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d5 \u05de\u05e0\u05d4 \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05d3\u05d7\u05d9\u05e4\u05d4 \u05d4\u05d9\u05d5\u05dd?"
    },
    "talking_points": {
      "type": "string",
      "description": "\u05de\u05e9\u05e4\u05d8\u05d9 \u05de\u05e4\u05ea\u05d7 \u05dc\u05de\u05dc\u05e6\u05e8 \u05e2\u05dc \u05d4\u05de\u05e0\u05d4"
    },
    "cost": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05d4\u05db\u05e0\u05d4"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05db\u05d9\u05d1\u05d9\u05dd"
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05dc\u05e8\u05d2\u05e0\u05d9\u05dd"
    },
    "prep_time": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05d4\u05db\u05e0\u05d4 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "popularity_score": {
      "type": "integer",
      "description": "\u05e6\u05d9\u05d5\u05df \u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05d5\u05ea"
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "seasonal": {
      "type": "boolean",
      "default": false
    },
    "image_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05d4"
    },
    "upsell_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05e6\u05e2\u05d5\u05ea \u05dc\u05e9\u05d3\u05e8\u05d5\u05d2"
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ]
}