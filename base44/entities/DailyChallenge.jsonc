    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d0\u05ea\u05d2\u05e8"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d0\u05ea\u05d2\u05e8"
    },
    "reward_coins": {
      "type": "number",
      "description": "\u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05dc\u05d6\u05db\u05d9\u05d9\u05d4",
      "default": 50
