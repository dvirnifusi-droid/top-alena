    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e9\u05d0\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    }
