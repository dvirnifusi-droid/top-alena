{
  "name": "ServiceStep",
  "type": "object",
  "properties": {
    "step_number": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e9\u05dc\u05d1 (1-23)"
    },
    "step_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05dc\u05d1"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e9\u05dc\u05d1"
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d8\u05d9\u05e4\u05d9\u05dd \u05d5\u05d3\u05d2\u05e9\u05d9\u05dd \u05dc\u05e9\u05dc\u05d1"
    },
    "estimated_duration": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05de\u05e9\u05d5\u05e2\u05e8 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "requires_pos": {
      "type": "boolean",
      "default": false,
      "description": "\u05d3\u05d5\u05e8\u05e9 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05e7\u05d5\u05e4\u05d4"
    },
    "requires_kitchen": {
      "type": "boolean",
      "default": false,
      "description": "\u05d3\u05d5\u05e8\u05e9 \u05ea\u05d9\u05d0\u05d5\u05dd \u05e2\u05dd \u05d4\u05de\u05d8\u05d1\u05d7"
    }
  },
  "required": [
    "step_number",
    "step_name",
    "description"
  ]
}