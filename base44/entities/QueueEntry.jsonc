{
  "name": "QueueEntry",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "party_size": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05e1\u05d5\u05e2\u05d3\u05d9\u05dd"
    },
    "seating_preference": {
      "type": "string",
      "enum": [
        "no_preference",
        "inside",
        "outside"
      ],
      "default": "no_preference",
      "description": "\u05d4\u05e2\u05d3\u05e4\u05ea \u05d4\u05d5\u05e9\u05d1\u05d4: \u05dc\u05d0 \u05de\u05e9\u05e0\u05d4 / \u05e8\u05e7 \u05d1\u05e4\u05e0\u05d9\u05dd / \u05e8\u05e7 \u05d1\u05d7\u05d5\u05e5"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "seated",
        "abandoned"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1: \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 / \u05e4\u05e2\u05d9\u05dc \u05d1\u05ea\u05d5\u05e8 / \u05d4\u05d5\u05bc\u05e9\u05d1 / \u05e0\u05d8\u05e9"
    },
    "treated": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e7\u05d9\u05d1\u05dc \u05e4\u05d9\u05e0\u05d5\u05e7"
    },
    "timestamp_register": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05e8\u05e9\u05de\u05d4"
    },
    "timestamp_approved": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "timestamp_seated": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05d5\u05e9\u05d1\u05d4"
    },
    "timestamp_end": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05d0\u05d5 \u05e0\u05d8\u05d9\u05e9\u05d4"
    },
    "sort_order": {
      "type": "integer",
      "description": "\u05e1\u05d3\u05e8 \u05d1\u05ea\u05d5\u05e8 \u05dc\u05e6\u05d5\u05e8\u05da Drag & Drop"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea"
    },
    "push_subscription": {
      "type": "object",
      "description": "Web Push subscription object"
    },
    "feedback_rating": {
      "type": "integer",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05dc\u05e7\u05d5\u05d7 1-5"
    },
    "feedback_sms_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7 SMS \u05e4\u05d9\u05d3\u05d1\u05e7"
    },
    "seat_countdown_active": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05de\u05d5\u05e0\u05d4 3 \u05d3\u05e7\u05d5\u05ea \u05e4\u05e2\u05d9\u05dc"
    },
    "seat_called_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e7\u05e8\u05d9\u05d0\u05d4 \u05dc\u05de\u05d6\u05d3\u05de\u05df"
    },
    "last_lat": {
      "type": "number",
      "description": "\u05e7\u05d5 \u05e8\u05d5\u05d7\u05d1 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "last_lng": {
      "type": "number",
      "description": "\u05e7\u05d5 \u05d0\u05d5\u05e8\u05da \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "last_location_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e2\u05d3\u05db\u05d5\u05df \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "proximity_check_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e9\u05e0\u05e9\u05dc\u05d7\u05d4 \u05d1\u05d3\u05d9\u05e7\u05ea \u05e7\u05e8\u05d1\u05d4"
    },
    "proximity_response": {
      "type": "string",
      "enum": [
        "pending",
        "yes",
        "no"
      ],
      "description": "\u05ea\u05d2\u05d5\u05d1\u05ea \u05e7\u05e8\u05d1\u05d4: \u05de\u05de\u05ea\u05d9\u05df / \u05db\u05df / \u05dc\u05d0"
    },
    "time_credits_earned": {
      "type": "integer",
      "default": 0,
      "description": "\u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05e9\u05e6\u05d1\u05e8\u05d5"
    },
    "time_credits_spent": {
      "type": "integer",
      "default": 0,
      "description": "\u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05e9\u05d4\u05d5\u05e6\u05d0\u05d5"
    },
    "selected_treat_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e4\u05d9\u05e0\u05d5\u05e7 \u05e9\u05e0\u05d1\u05d7\u05e8"
    },
    "estimated_wait_time": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05d4\u05de\u05ea\u05e0\u05d4 \u05de\u05d5\u05e2\u05e8\u05da \u05d1\u05d3\u05e7\u05d5\u05ea (\u05de\u05db\u05ea\u05d9\u05d1 \u05d4\u05de\u05d0\u05e8\u05d7\u05ea)"
    },
    "customer_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea / \u05d4\u05d6\u05de\u05e0\u05d5\u05ea \u05de\u05d9\u05d5\u05d7\u05d3\u05d5\u05ea \u05de\u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "table_duration_preference": {
      "type": "string",
      "enum": [
        "any",
        "one_hour_only"
      ],
      "default": "any",
      "description": "\u05d4\u05e2\u05d3\u05e4\u05ea \u05de\u05e9\u05da \u05e9\u05d5\u05dc\u05d7\u05df: \u05db\u05dc \u05de\u05e9\u05da / \u05e9\u05e2\u05d4 \u05d1\u05dc\u05d1\u05d3"
    }
  },
  "required": [
    "customer_name",
    "phone",
    "party_size"
  ]
}