{
  "name": "Incident",
  "type": "object",
  "properties": {
    "incident_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05e7\u05e8\u05d9\u05ea \u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "category": {
      "type": "string",
      "enum": [
        "customer_service",
        "maintenance",
        "cleanliness",
        "staff",
        "security",
        "safety",
        "kitchen",
        "bar",
        "pos_system"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "\u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "investigating",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "reported",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "visibility_level": {
      "type": "string",
      "enum": [
        "managers_only",
        "managers_and_employees",
        "employees_only",
        "owners_only"
      ],
      "default": "managers_and_employees",
      "description": "\u05e8\u05de\u05ea \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05e6\u05e4\u05d9\u05d9\u05d4 \u05d1\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "reported_by": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d7\u05e8\u05d0\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05d6\u05de\u05df \u05d4\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05ea\u05e7\u05e8\u05d9\u05ea"
    },
    "customer_reaction": {
      "type": "string",
      "description": "\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05dc\u05e7\u05d5\u05d7 (\u05e2\u05d1\u05d5\u05e8 \u05ea\u05e7\u05e8\u05d9\u05d5\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea)"
    },
    "solution_provided": {
      "type": "string",
      "description": "\u05d4\u05e4\u05ea\u05e8\u05d5\u05df \u05e9\u05e0\u05d9\u05ea\u05df"
    },
    "impact_on_shift": {
      "type": "string",
      "description": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "estimated_cost": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05dc\u05ea\u05d9\u05e7\u05d5\u05df"
    },
    "resolution_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05ea\u05e8\u05d5\u05df"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false,
      "description": "\u05e0\u05d3\u05e8\u05e9 \u05de\u05e2\u05e7\u05d1 \u05e0\u05d5\u05e1\u05e3"
    },
    "prevention_measures": {
      "type": "string",
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05de\u05e0\u05d9\u05e2\u05d4 \u05dc\u05e2\u05ea\u05d9\u05d3"
    }
  },
  "required": [
    "title",
    "description",
    "category",
    "severity",
    "reported_by",
    "incident_date"
  ]
}