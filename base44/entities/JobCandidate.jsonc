{
  "name": "JobCandidate",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "age": {
      "type": "integer",
      "description": "\u05d2\u05d9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "city": {
      "type": "string",
      "description": "\u05e2\u05d9\u05e8 \u05de\u05d2\u05d5\u05e8\u05d9\u05dd"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "role_applied": {
      "type": "string",
      "enum": [
        "\u05de\u05dc\u05e6\u05e8\u05d5\u05ea",
        "\u05de\u05d8\u05d1\u05d7",
        "\u05d1\u05e8",
        "\u05de\u05d0\u05e8\u05d7\u05ea",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e4\u05d5\u05e0\u05d4 \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "experience": {
      "type": "string",
      "description": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e7\u05d5\u05d3\u05dd \u05d1\u05de\u05e1\u05e2\u05d3\u05d5\u05ea"
    },
    "shifts_per_week": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05d1\u05e9\u05d1\u05d5\u05e2"
    },
    "weekend_availability": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d6\u05de\u05d9\u05df \u05dc\u05e1\u05d5\u05e4\u05d9 \u05e9\u05d1\u05d5\u05e2"
    },
    "start_date": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05dc\u05e2\u05d1\u05d5\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05d5\u05e2\u05de\u05d3"
    },
    "score": {
      "type": "integer",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05d0\u05de\u05d4 \u05e9\u05e0\u05ea\u05df \u05d4\u05d1\u05d5\u05d8 (0-100)"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "source": {
      "type": "string",
      "default": "whatsapp",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e4\u05e0\u05d9\u05d9\u05d4"
    },
    "_notified_abandoned": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7\u05d4 \u05db\u05d1\u05e8 \u05d4\u05ea\u05e8\u05d0\u05ea \u05e0\u05d8\u05d9\u05e9\u05d4 \u05e2\u05dc \u05de\u05d5\u05e2\u05de\u05d3 \u05d6\u05d4"
    }
  },
  "required": [
    "full_name"
  ]
}