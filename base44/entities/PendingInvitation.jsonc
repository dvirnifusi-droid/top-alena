{
  "name": "PendingInvitation",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05d5\u05d6\u05de\u05df"
    },
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05de\u05d5\u05d6\u05de\u05df"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05de\u05e2\u05e8\u05db\u05ea"
    },
    "invitation_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05d6\u05de\u05e0\u05d4 \u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "invited_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d4\u05d6\u05de\u05d9\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    }
  },
  "required": [
    "email",
    "full_name",
    "role",
    "invitation_code"
  ]
}