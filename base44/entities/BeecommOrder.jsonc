{
  "name": "BeecommOrder",
  "type": "object",
  "properties": {
    "order_center_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05de\u05e8\u05db\u05d6 \u05d4\u05d4\u05d6\u05de\u05e0\u05d5\u05ea"
    },
    "pos_order_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e7\u05d5\u05e4\u05d4"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05e7\u05d5\u05d7"
    },
    "order_type": {
      "type": "integer",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d6\u05de\u05e0\u05d4 (1=\u05de\u05e9\u05dc\u05d5\u05d7, 2=\u05d0\u05d9\u05e1\u05d5\u05e3)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05e4\u05e8\u05d8\u05d9 \u05d4\u05de\u05e0\u05d5\u05ea"
    },
    "total_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05db\u05d5\u05dc\u05dc"
    },
    "delivery_address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "error"
      ],
      "default": "sent",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "order_type",
    "items"
  ]
}