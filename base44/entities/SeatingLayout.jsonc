{
  "name": "SeatingLayout",
  "type": "object",
  "properties": {
    "layout_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05de\u05e4\u05ea \u05d4\u05d4\u05d5\u05e9\u05d1\u05d4 (\u05dc\u05de\u05e9\u05dc '\u05e8\u05d0\u05e9\u05d9', '\u05de\u05e8\u05e4\u05e1\u05ea \u05e7\u05d9\u05e5')"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table_number": {
            "type": "string"
          },
          "min_capacity": {
            "type": "integer"
          },
          "max_capacity": {
            "type": "integer"
          },
          "location": {
            "type": "string",
            "enum": [
              "indoor",
              "outdoor"
            ]
          },
          "area": {
            "type": "string"
          },
          "combinable_with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x": {
            "type": "number",
            "description": "\u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05d8\u05ea X \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05de\u05e4\u05d4"
          },
          "y": {
            "type": "number",
            "description": "\u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05d8\u05ea Y \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05de\u05e4\u05d4"
          },
          "width": {
            "type": "number",
            "description": "\u05e8\u05d5\u05d7\u05d1 \u05d4\u05e9\u05d5\u05dc\u05d7\u05df \u05d1\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd"
          },
          "height": {
            "type": "number",
            "description": "\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e9\u05d5\u05dc\u05d7\u05df \u05d1\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd"
          }
        },
        "required": [
          "table_number",
          "min_capacity",
          "max_capacity",
          "location"
        ]
      },
      "description": "\u05de\u05e2\u05e8\u05da \u05e9\u05dc \u05db\u05dc \u05d4\u05e9\u05d5\u05dc\u05d7\u05e0\u05d5\u05ea \u05d1\u05de\u05e4\u05d4"
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05d0\u05dc\u05de\u05e0\u05d8"
          },
          "type": {
            "type": "string",
            "enum": [
              "restroom",
              "kitchen",
              "bar",
              "reception",
              "storage",
              "entrance",
              "stage",
              "cashier"
            ],
            "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05dc\u05de\u05e0\u05d8 \u05d4\u05e4\u05d9\u05d6\u05d9"
          },
          "name": {
            "type": "string",
            "description": "\u05e9\u05dd \u05d4\u05d0\u05dc\u05de\u05e0\u05d8"
          },
          "x": {
            "type": "number",
            "description": "\u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05d8\u05ea X \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05de\u05e4\u05d4"
          },
          "y": {
            "type": "number",
            "description": "\u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05d8\u05ea Y \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05de\u05e4\u05d4"
          },
          "width": {
            "type": "number",
            "description": "\u05e8\u05d5\u05d7\u05d1 \u05d4\u05d0\u05dc\u05de\u05e0\u05d8 \u05d1\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd"
          },
          "height": {
            "type": "number",
            "description": "\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d0\u05dc\u05de\u05e0\u05d8 \u05d1\u05e4\u05d9\u05e7\u05e1\u05dc\u05d9\u05dd"
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "x",
          "y",
          "width",
          "height"
        ]
      },
      "description": "\u05de\u05e2\u05e8\u05da \u05e9\u05dc \u05d0\u05dc\u05de\u05e0\u05d8\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd \u05d1\u05de\u05e4\u05d4 (\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd, \u05de\u05d8\u05d1\u05d7, \u05d1\u05e8 \u05d5\u05db\u05d5')"
    }
  },
  "required": [
    "layout_name",
    "tables"
  ]
}