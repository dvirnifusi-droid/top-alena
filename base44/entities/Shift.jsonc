{
  "name": "Shift",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3 \u05d4\u05de\u05e9\u05d5\u05d9\u05da \u05dc\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "employee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "hours_worked": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05e9\u05e2\u05d5\u05ea \u05e9\u05e2\u05d1\u05d3"
    },
    "sales_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05d1\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "sales_target": {
      "type": "number",
      "description": "\u05d9\u05e2\u05d3 \u05d4\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05dc\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "manager_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de\u05e0\u05d4\u05dc \u05dc\u05de\u05e9\u05de\u05e8\u05ea (1-5)"
    },
    "customer_service_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 100,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea (1-100)"
    },
    "area": {
      "type": "string",
      "description": "\u05d0\u05d6\u05d5\u05e8 \u05e9\u05d9\u05e8\u05d5\u05ea (\u05dc\u05de\u05e9\u05dc: \u05e4\u05d8\u05d9\u05d5, \u05d1\u05e8, \u05de\u05e8\u05db\u05d6\u05d9)"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e2\u05dc \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    }
  },
  "required": [
    "employee_id",
    "date",
    "hours_worked",
    "sales_amount"
  ]
}