{
  "name": "ShiftTracking",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "employee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "shift_start": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "shift_end": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_break",
        "completed"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "breaks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "break_start": {
            "type": "string",
            "format": "date-time"
          },
          "break_end": {
            "type": "string",
            "format": "date-time"
          },
          "duration_minutes": {
            "type": "number"
          }
        }
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e4\u05e1\u05e7\u05d5\u05ea \u05d1\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "total_break_minutes": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05da \u05d6\u05de\u05df \u05d4\u05d4\u05e4\u05e1\u05e7\u05d5\u05ea \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "had_meal": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d0\u05db\u05dc \u05d1\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "meal_details": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d8\u05d9 \u05d4\u05d0\u05e8\u05d5\u05d7\u05d4"
    },
    "total_hours": {
      "type": "number",
      "description": "\u05e1\u05da \u05e9\u05e2\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e8\u05ea (\u05db\u05d5\u05dc\u05dc \u05d4\u05e4\u05e1\u05e7\u05d5\u05ea)"
    },
    "effective_hours": {
      "type": "number",
      "description": "\u05e9\u05e2\u05d5\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4 \u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea (\u05d1\u05dc\u05d9 \u05d4\u05e4\u05e1\u05e7\u05d5\u05ea)"
    },
    "atmosphere_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d0\u05d5\u05d5\u05d9\u05e8\u05d4 \u05d1\u05de\u05e9\u05de\u05e8\u05ea (1-5)"
    },
    "sales_feeling_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05ea\u05d7\u05d5\u05e9\u05ea \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\u05e9\u05de\u05e8\u05ea (1-5)"
    },
    "effort_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de\u05d0\u05de\u05e5 \u05d0\u05d9\u05e9\u05d9 \u05d1\u05de\u05e9\u05de\u05e8\u05ea (1-5)"
    },
    "personal_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d5\u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d4\u05e2\u05d5\u05d1\u05d3"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "date",
    "shift_start"
  ]
}