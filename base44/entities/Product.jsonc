{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e4\u05e7 \u05d4\u05de\u05e1\u05e4\u05e7 \u05d0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "beverage",
        "alcohol",
        "cleaning",
        "other"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05dc\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "liter",
        "piece",
        "bottle",
        "package"
      ],
      "description": "\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d9\u05d3\u05d4"
    },
    "current_stock": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d1\u05de\u05dc\u05d0\u05d9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "desired_stock": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05e8\u05e6\u05d5\u05d9\u05d4 \u05d1\u05de\u05dc\u05d0\u05d9 (\u05e1\u05e3 \u05d4\u05d6\u05de\u05e0\u05d4)"
    }
  },
  "required": [
    "name",
    "supplier_id",
    "price",
    "unit",
    "current_stock",
    "desired_stock"
  ]
}