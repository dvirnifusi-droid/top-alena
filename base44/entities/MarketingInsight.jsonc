{
  "name": "MarketingInsight",
  "type": "object",
  "properties": {
    "insight_type": {
      "type": "string",
      "enum": [
        "customer_behavior",
        "market_trend",
        "competitor_analysis",
        "performance_optimization",
        "seasonal_opportunity",
        "cost_reduction",
        "revenue_boost"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "data_source": {
      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05d1\u05e1\u05d9\u05e1 \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "confidence_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "\u05e8\u05de\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d1\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "potential_impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "game_changing"
      ],
      "description": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05de\u05d5\u05de\u05dc\u05e6\u05d5\u05ea"
    },
    "expected_roi": {
      "type": "number",
      "description": "\u05ea\u05e9\u05d5\u05d0\u05d4 \u05e6\u05e4\u05d5\u05d9\u05d4 \u05e2\u05dc \u05d4\u05e9\u05e7\u05e2\u05d4"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "\u05d3\u05d7\u05d9\u05e4\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05d5\u05d1\u05e0\u05d4"
    },
    "related_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d3\u05d3\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd"
    },
    "implementation_difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "complex"
      ],
      "description": "\u05e7\u05d5\u05e9\u05d9 \u05d9\u05d9\u05e9\u05d5\u05dd"
    }
  },
  "required": [
    "insight_type",
    "title",
    "description",
    "confidence_level"
  ]
}