{
  "name": "GeminiFileCache",
  "type": "object",
  "properties": {
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID"
    },
    "file_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5"
    },
    "gemini_file_uri": {
      "type": "string",
      "description": "URI \u05e9\u05dc \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d1-Gemini File API"
    },
    "mime_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e7\u05d5\u05d1\u05e5"
    },
    "last_uploaded": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05d5\u05e2\u05dc\u05d4 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    }
  },
  "required": [
    "drive_file_id",
    "file_name",
    "gemini_file_uri"
  ]
}