{
  "name": "IntegrationSecret",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Secret identifier (e.g. META_ADS_ACCESS_TOKEN)"
    },
    "value": {
      "type": "string",
      "description": "Secret value (stored plaintext — DB-level trust)"
    },
    "note": {
      "type": "string",
      "description": "Optional human label / context"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["key", "value"]
}
