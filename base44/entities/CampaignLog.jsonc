{
  "name": "CampaignLog",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "instagram"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "channel": {
      "type": "string",
      "description": "\u05e2\u05e8\u05d5\u05e5 \u05d4\u05e4\u05e8\u05e1\u05d5\u05dd (instagram, email, sms \u05d5\u05db\u05d5')"
    },
    "subject": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05de\u05d9\u05d9\u05dc (\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05de\u05d9\u05d9\u05dc \u05d1\u05dc\u05d1\u05d3)"
    },
    "body_preview": {
      "type": "string",
      "description": "\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05e9\u05dc \u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 (100 \u05ea\u05d5\u05d5\u05d9\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd)"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e4\u05d5\u05e1\u05d8 \u05d0\u05d5 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "image_url": {
      "type": "string",
      "description": "URL \u05e9\u05dc \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 (\u05dc\u05de\u05e9\u05dc \u05e2\u05d1\u05d5\u05e8 \u05e4\u05d5\u05e1\u05d8\u05d9\u05dd \u05d1\u05d0\u05d9\u05e0\u05e1\u05d8\u05d2\u05e8\u05dd)"
    },
    "topic": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05e4\u05d5\u05e1\u05d8 \u05d0\u05d5 \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "failed"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df"
    },
    "post_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e4\u05d5\u05e1\u05d8 \u05d1\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05d4 \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05d4 \u05de\u05ea\u05d5\u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05e4\u05e8\u05e1\u05d5\u05dd"
    },
    "recipients_count": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05d4\u05e0\u05de\u05e2\u05e0\u05d9\u05dd"
    },
    "sent_count": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05e9\u05dc\u05d7\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "failed_count": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05db\u05e9\u05dc\u05d5"
    },
    "template_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05e9\u05d9\u05de\u05e9\u05d4 (\u05d0\u05dd \u05e0\u05d1\u05d7\u05e8\u05d4)"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d4\u05e9\u05dc\u05d9\u05d7\u05d4/\u05e4\u05e8\u05e1\u05d5\u05dd"
    }
  },
  "required": [
    "type",
    "sent_at"
  ]
}