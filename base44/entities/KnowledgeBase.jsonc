      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d9\u05d3\u05e2"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d9\u05d3\u05e2"
    },
    "keywords": {
      "type": "array",
      "items": {
