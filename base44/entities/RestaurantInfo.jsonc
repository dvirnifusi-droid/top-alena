{
  "name": "RestaurantInfo",
  "type": "object",
  "properties": {
    "info_type": {
      "type": "string",
      "enum": [
        "kashrut",
        "hours",
        "location",
        "policies",
        "general",
        "special_services",
        "reservations",
        "payment",
        "accessibility"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d9\u05d3\u05e2"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d9\u05d3\u05e2"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05de\u05e4\u05d5\u05e8\u05d8"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d9\u05d3\u05e2 \u05e4\u05e2\u05d9\u05dc \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5 \u05d1\u05e1\u05d9\u05de\u05d5\u05dc\u05e6\u05d9\u05d4"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4\u05de\u05d9\u05d3\u05e2"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05dc\u05d5\u05ea \u05de\u05e4\u05ea\u05d7 \u05e9\u05de\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05d6\u05d4"
    }
  },
  "required": [
    "info_type",
    "title",
    "content"
  ]
}