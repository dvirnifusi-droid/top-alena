{
  "name": "AccountantExport",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "\u05d8\u05d5\u05e7\u05df \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05d5\u05de\u05d0\u05d5\u05d1\u05d8\u05d7 \u05dc\u05d2\u05d9\u05e9\u05d4 \u05dc\u05e2\u05de\u05d5\u05d3",
      "unique": true
    },
    "accountant_email": {
      "type": "string",
      "format": "email",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05e8\u05d5\u05d0\u05d4 \u05d4\u05d7\u05e9\u05d1\u05d5\u05df"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4 \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05d5\u05ea"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "viewed",
        "expired"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05e4\u05d5\u05d2\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8"
    }
  },
  "required": [
    "token",
    "accountant_email",
    "start_date",
    "end_date",
    "expires_at"
  ]
}