{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "time": {
      "type": "string",
      "format": "time",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "party_size": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d5\u05e2\u05d3\u05d9\u05dd"
    },
    "table_preference": {
      "type": "string",
      "description": "\u05d4\u05e2\u05d3\u05e4\u05ea \u05de\u05d9\u05e7\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "pending",
        "seated",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "pending"
    },
    "special_occasion": {
      "type": "string",
      "enum": [
        "birthday",
        "anniversary",
        "business",
        "date",
        "celebration"
      ],
      "description": "\u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05d9\u05d5\u05d7\u05d3"
    },
    "special_requests": {
      "type": "string",
      "description": "\u05d1\u05e7\u05e9\u05d5\u05ea \u05de\u05d9\u05d5\u05d7\u05d3\u05d5\u05ea"
    },
    "assigned_table": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e9\u05d5\u05dc\u05d7\u05df \u05d0\u05d5 \u05e9\u05d5\u05dc\u05d7\u05e0\u05d5\u05ea \u05e9\u05d4\u05d5\u05e7\u05e6\u05d5"
    },
    "reservation_end_time": {
      "type": "string",
      "format": "time",
      "description": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd \u05de\u05e9\u05d5\u05e2\u05e8\u05ea \u05e9\u05dc \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    }
  },
  "required": [
    "customer_name",
    "date",
    "time",
    "party_size"
  ]
}