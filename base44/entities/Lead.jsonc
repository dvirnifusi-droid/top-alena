{
  "name": "Lead",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Unique lead id"
    },
    "source_unit": {
      "type": "string",
      "description": "CampaignUnit.unit_id that generated this lead"
    },
    "channel": {
      "type": "string",
      "enum": [
        "APP_INQUIRY",
        "WHATSAPP",
        "PHONE",
        "WALK_IN",
        "REFERRAL"
      ],
      "description": "Where the lead came from"
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "QUALIFIED",
        "QUOTED",
        "BOOKED",
        "LOST",
        "COLD"
      ],
      "default": "NEW"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "qualifier_answers": {
      "type": "object",
      "description": "{event_date, event_type, guest_count, budget_per_person}"
    },
    "conversation_log": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of {role, content, timestamp}"
    },
    "quoted_amount_ils": {
      "type": "number"
    },
    "booked_amount_ils": {
      "type": "number"
    },
    "reservation_id": {
      "type": "string",
      "description": "Link to existing Reservation entity if BOOKED"
    },
    "lost_reason": {
      "type": "string",
      "enum": [
        "PRICE",
        "DATE_UNAVAIL",
        "GHOSTED",
        "OTHER"
      ]
    },
    "assigned_to_agent": {
      "type": "string",
      "description": "Sales-Closer codename"
    },
    "owner_alerted": {
      "type": "boolean",
      "default": false
    },
    "utm": {
      "type": "object",
      "description": "{source, medium, campaign, content}"
    }
  },
  "required": [
    "source_unit",
    "channel"
  ]
}
