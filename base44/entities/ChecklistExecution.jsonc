{
  "name": "ChecklistExecution",
  "type": "object",
  "properties": {
    "checklist_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e8\u05e9\u05d9\u05de\u05ea \u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "executed_by": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d1\u05e6\u05e2 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "executed_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d1\u05e6\u05e2 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "approving_manager_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d7\u05de\u05f4\u05e9 \u05d4\u05de\u05d0\u05e9\u05e8"
    },
    "execution_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05d6\u05de\u05df \u05d1\u05d9\u05e6\u05d5\u05e2"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "failed",
        "requires_attention"
      ],
      "default": "in_progress",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05d9\u05e6\u05d5\u05e2"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "performed_by": {
            "type": "string",
            "description": "\u05de\u05d9 \u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d4\u05d6\u05d5"
          },
          "requires_followup": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "\u05e6\u05d9\u05d5\u05df \u05db\u05dc\u05dc\u05d9"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false,
      "description": "\u05e0\u05d3\u05e8\u05e9 \u05de\u05e2\u05e7\u05d1"
    },
    "completion_time_minutes": {
      "type": "number",
      "description": "\u05d6\u05de\u05df \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05e7\u05d5\u05ea"
    }
  },
  "required": [
    "checklist_id",
    "executed_by",
    "execution_date"
  ]
}