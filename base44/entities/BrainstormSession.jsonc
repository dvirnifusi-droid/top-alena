{
  "name": "BrainstormSession",
  "type": "object",
  "properties": {
    "session_title": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05e1\u05d9\u05e2\u05d5\u05e8 \u05de\u05d5\u05d7\u05d5\u05ea"
    },
    "challenge": {
      "type": "string",
      "description": "\u05d4\u05d0\u05ea\u05d2\u05e8 \u05d0\u05d5 \u05d4\u05d1\u05e2\u05d9\u05d4 \u05e9\u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05e0\u05e1\u05d9\u05dd \u05dc\u05e4\u05ea\u05d5\u05e8"
    },
    "brainstorm_prompt": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d0\u05dc\u05d4 \u05d0\u05d5 \u05d4\u05e0\u05d5\u05e9\u05d0 \u05e9\u05e0\u05e9\u05dc\u05d7 \u05dcAI"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          },
          "cost_level": {
            "type": "string"
          },
          "impact_potential": {
            "type": "string"
          }
        }
      },
      "description": "\u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05d4\u05e6\u05d9\u05e2 AI"
    },
    "user_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d5\u05d4\u05d5\u05e1\u05e4\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "selected_ideas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05e0\u05d1\u05d7\u05e8\u05d5 \u05dc\u05d9\u05d9\u05e9\u05d5\u05dd"
    },
    "implementation_plan": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d9\u05d9\u05e9\u05d5\u05dd \u05d4\u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea"
    },
    "expected_impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "revolutionary"
      ],
      "description": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e6\u05e4\u05d5\u05d9\u05d4"
    },
    "budget_estimate": {
      "type": "number",
      "description": "\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05e7\u05e6\u05d9\u05d1 \u05dc\u05d9\u05d9\u05e9\u05d5\u05dd"
    },
    "timeline": {
      "type": "string",
      "description": "\u05dc\u05d5\u05d7 \u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05d9\u05d9\u05e9\u05d5\u05dd"
    },
    "success_probability": {
      "type": "number",
      "description": "\u05d4\u05e1\u05ea\u05d1\u05e8\u05d5\u05ea \u05d4\u05e6\u05dc\u05d7\u05d4 (0-100)"
    },
    "session_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e1\u05e9\u05df"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05de\u05e2\u05e7\u05d1"
    }
  },
  "required": [
    "session_title",
    "challenge",
    "brainstorm_prompt"
  ]
}