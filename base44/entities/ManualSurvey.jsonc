{
  "name": "ManualSurvey",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "sent_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05e1\u05e7\u05e8"
    },
    "survey_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05d5\u05e7\u05e6\u05e8 \u05dc\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05e1\u05e7\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "viewed",
        "completed"
      ],
      "default": "sent",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e1\u05e7\u05e8"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e2\u05dc \u05d4\u05e1\u05e7\u05e8"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "sent_by",
    "survey_id"
  ]
}