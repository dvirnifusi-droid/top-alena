{
  "name": "TipReport",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d3\u05d5\u05d7"
    },
    "total_tips_collected": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05d8\u05d9\u05e4\u05d9\u05dd \u05e9\u05e0\u05d0\u05e1\u05e4\u05d5"
    },
    "total_meal_amount": {
      "type": "number",
      "description": "\u05e9\u05d5\u05d5\u05d9 \u05d0\u05e8\u05d5\u05d7\u05d5\u05ea \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd"
    },
    "runner_deduction": {
      "type": "number",
      "description": "\u05d4\u05e4\u05e8\u05e9\u05d4 \u05dc\u05e8\u05d0\u05e0\u05e8\u05d9\u05dd"
    },
    "restaurant_deduction": {
      "type": "number",
      "description": "\u05d4\u05e4\u05e8\u05e9\u05d4 \u05dc\u05de\u05e1\u05e2\u05d3\u05d4"
    },
    "net_tips_for_distribution": {
      "type": "number",
      "description": "\u05d9\u05ea\u05e8\u05d4 \u05dc\u05d7\u05dc\u05d5\u05e7\u05d4"
    },
    "tip_per_hour": {
      "type": "number",
      "description": "\u05d8\u05d9\u05e4 \u05dc\u05e9\u05e2\u05d4"
    },
    "staff_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "string"
          },
          "employee_name": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "total_hours": {
            "type": "number"
          },
          "break_minutes": {
            "type": "number"
          },
          "effective_hours": {
            "type": "number"
          },
          "hourly_deduction": {
            "type": "number"
          },
          "meal_cost": {
            "type": "number"
          },
          "sales_bonus": {
            "type": "number"
          },
          "gross_tip": {
            "type": "number"
          },
          "final_tip": {
            "type": "number"
          },
          "supplement": {
            "type": "number",
            "description": "\u05d4\u05e9\u05dc\u05de\u05d4 \u05dc\u05e9\u05db\u05e8 \u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05d0\u05dd \u05e0\u05d3\u05e8\u05e9"
          },
          "total_earnings": {
            "type": "number",
            "description": "\u05e1\u05d4\u05db \u05e8\u05d5\u05d5\u05d7 (\u05d8\u05d9\u05e4 + \u05d4\u05e9\u05dc\u05de\u05d4)"
          },
          "employee_signature": {
            "type": "string",
            "description": "\u05d7\u05ea\u05d9\u05de\u05d4 \u05d3\u05d9\u05d2\u05d9\u05d8\u05dc\u05d9\u05ea/\u05d0\u05d9\u05e9\u05d5\u05e8 \u05e2\u05d5\u05d1\u05d3"
          }
        }
      },
      "description": "\u05e4\u05d9\u05e8\u05d5\u05d8 \u05dc\u05db\u05dc \u05e2\u05d5\u05d1\u05d3"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "lunch",
        "dinner"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "locked",
        "approved",
        "paid"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d3\u05d5\u05d7"
    },
    "locked_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e0\u05e2\u05dc \u05d0\u05ea \u05d4\u05d3\u05d5\u05d7"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e0\u05e2\u05dc \u05d4\u05d3\u05d5\u05d7"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea"
    },
    "opening_employee_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05e9\u05e2\u05e9\u05d5 \u05e4\u05ea\u05d9\u05d7\u05d4"
    },
    "closing_employee_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05e9\u05e2\u05e9\u05d5 \u05e1\u05d2\u05d9\u05e8\u05d4"
    }
  },
  "required": [
    "date",
    "total_tips_collected",
    "staff_details"
  ]
}