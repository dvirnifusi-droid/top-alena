{
  "name": "TrainingLesson",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8",
      "unique": true
    },
    "course_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05e8\u05e1 \u05d4\u05de\u05e9\u05d5\u05d9\u05da"
    },
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text",
        "video",
        "quiz",
        "simulation",
        "game",
        "menu",
        "tone_training"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d5\u05db\u05df \u05e9\u05dc \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8"
    },
    "content": {
      "type": "string",
      "description": "\u05d4\u05ea\u05d5\u05db\u05df \u05e9\u05dc \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 (\u05d8\u05e7\u05e1\u05d8, URL \u05dc\u05e1\u05e8\u05d8\u05d5\u05df, \u05de\u05d6\u05d4\u05d4 \u05dc\u05de\u05d1\u05d7\u05df/\u05e1\u05d9\u05de\u05d5\u05dc\u05e6\u05d9\u05d4/\u05de\u05e9\u05d7\u05e7)"
    },
    "order": {
      "type": "integer",
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d1\u05e7\u05d5\u05e8\u05e1"
    }
  },
  "required": [
    "lesson_id",
    "course_code",
    "title",
    "content_type",
    "order"
  ]
}