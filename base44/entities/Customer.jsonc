      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "visit_count": {
      "type": "integer",
      "default": 0,
      "description": "\u05db\u05de\u05d5\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05d1\u05ea\u05d5\u05e8"
