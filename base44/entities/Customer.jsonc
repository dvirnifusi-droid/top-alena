    "coin_balance": {
      "type": "integer",
      "default": 0,
      "description": "\u05d9\u05ea\u05e8\u05ea \u05de\u05d8\u05d1\u05e2\u05d5\u05ea \u05e2\u05dc\u05d9\u05e0\u05d0 \u05d3\u05d9\u05d2\u05d9\u05d8\u05dc\u05d9\u05d9\u05dd"
