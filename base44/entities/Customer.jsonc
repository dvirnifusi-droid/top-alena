      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05e1 \u05dc\u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "last_visit": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "group_size_preference": {
      "type": "integer",
      "description": "\u05d2\u05d5\u05d3\u05dc \u05e7\u05d1\u05d5\u05e6\u05d4 \u05e2\u05d3\u05d9\u05e3"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea CRM - Couple, Group6Plus, HighSpender \u05d5\u05db\u05d5'"
    },
    "rating_received": {
      "type": "integer",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de\u05de\u05d5\u05e6\u05e2 \u05e9\u05d4\u05dc\u05e7\u05d5\u05d7 \u05e0\u05ea\u05df"
