{
  "name": "ChecklistExecutionArchive",
  "type": "object",
  "properties": {
    "original_execution_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "checklist_title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e6'\u05e7\u05dc\u05d9\u05e1\u05d8"
    },
    "executed_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05de\u05d1\u05e6\u05e2 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "approving_manager_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d7\u05de\u05f4\u05e9 \u05e9\u05d0\u05d9\u05e9\u05e8"
    },
    "executed_by_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d1\u05e6\u05e2 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "execution_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05d6\u05de\u05df \u05d1\u05d9\u05e6\u05d5\u05e2"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "evening",
        "night"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "overall_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05db\u05dc\u05dc\u05d9 \u05d0\u05d7\u05d5\u05d6\u05d9"
    },
    "total_items": {
      "type": "integer",
      "description": "\u05e1\u05d4\"\u05db \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d1\u05e6'\u05e7\u05dc\u05d9\u05e1\u05d8"
    },
    "completed_items": {
      "type": "integer",
      "description": "\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e9\u05d4\u05d5\u05e9\u05dc\u05de\u05d5 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "failed_items": {
      "type": "integer",
      "description": "\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e9\u05dc\u05d0 \u05d4\u05d5\u05e9\u05dc\u05de\u05d5"
    },
    "critical_failures": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05db\u05e9\u05dc\u05d5\u05e0\u05d5\u05ea \u05d1\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd"
    },
    "completion_time_minutes": {
      "type": "number",
      "description": "\u05d6\u05de\u05df \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "detailed_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_order": {
            "type": "integer"
          },
          "area": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "performed_by": {
            "type": "string",
            "description": "\u05de\u05d9 \u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05de\u05e4\u05d5\u05e8\u05d8\u05d5\u05ea \u05dc\u05db\u05dc \u05e4\u05e8\u05d9\u05d8"
    },
    "general_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2"
    },
    "follow_up_required": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05de\u05e2\u05e7\u05d1 \u05e0\u05d5\u05e1\u05e3"
    },
    "issues_summary": {
      "type": "string",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05d1\u05e2\u05d9\u05d5\u05ea \u05e9\u05e0\u05de\u05e6\u05d0\u05d5"
    }
  },
  "required": [
    "original_execution_id",
    "checklist_title",
    "executed_by_name",
    "executed_by_id",
    "execution_date"
  ]
}