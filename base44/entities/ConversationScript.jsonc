      "description": "\u05e9\u05dd \u05d4\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4"
    },
    "role": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05ea\u05e8\u05d2\u05dc"
    },
    "customer_prompt": {
      "type": "string",
      "description": "\u05de\u05d4 \u05d4\u05dc\u05e7\u05d5\u05d7 \u05d0\u05d5\u05de\u05e8"
    },
    "correct_response": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "incorrect_response": {
      "type": "string",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e9\u05d2\u05d5\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "feedback_note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05ea \u05d4\u05d3\u05e8\u05db\u05d4 \u05d5\u05d4\u05e1\u05d1\u05e8"
    }
  },
  "required": [
    "script_id",
    "situation_name",
    "role",
    "customer_prompt",
    "correct_response"
  ]
