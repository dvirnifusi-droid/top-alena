{
  "name": "AvailabilityFormSettings",
  "type": "object",
  "properties": {
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "default_position": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d7\u05d8\u05d9\u05d1\u05d5\u05ea (\u05e4\u05dc\u05d5\u05e8/\u05de\u05d8\u05d1\u05d7) \u05e2\u05dd \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05d9\u05e8\u05d5\u05d3\u05d9\u05dd \u05dc\u05db\u05dc \u05d0\u05d7\u05ea"
    },
    "availability_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      },
      "description": "\u05e1\u05d5\u05d2\u05d9 \u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05de\u05d9\u05e0\u05d9\u05dd"
    },
    "shift_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05de\u05e9\u05de\u05e8\u05ea"
    },
    "default_days_unavailable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d9\u05de\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd \u05e9\u05d4\u05dd \u05d1\u05d1\u05e8\u05d9\u05e8\u05d4 \u05de\u05d7\u05d3\u05dc '\u05dc\u05d0 \u05e4\u05e0\u05d5\u05d9' \u05dc\u05db\u05d5\u05dc\u05dd (Sunday, Monday \u05d5\u05db\u05d5')"
    },
    "week_starts_offset": {
      "type": "integer",
      "default": 7,
      "description": "\u05db\u05de\u05d4 \u05d9\u05de\u05d9\u05dd \u05de\u05d4\u05d9\u05d5\u05dd \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05d4\u05e9\u05d1\u05d5\u05e2 \u05dc\u05e2\u05de\u05d5\u05d3 \u05d4\u05d2\u05e9\u05ea \u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05d9\u05d5\u05ea"
    }
  },
  "required": [
    "departments"
  ]
}