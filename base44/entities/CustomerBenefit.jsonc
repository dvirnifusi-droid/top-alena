{
  "name": "CustomerBenefit",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05dc\u05e7\u05d5\u05d7 \u05d4\u05de\u05e9\u05d5\u05d9\u05da \u05dc\u05d4\u05d8\u05d1\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05d4\u05d8\u05d1\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05d9\u05e6\u05d5\u05d9 (\u05dc\u05de\u05e9\u05dc: '\u05e7\u05d9\u05e0\u05d5\u05d7 \u05e2\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05d1\u05d9\u05ea')"
    },
    "type": {
      "type": "string",
      "enum": [
        "compensation",
        "offer",
        "birthday_gift",
        "welcome_gift"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d8\u05d1\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "redeemed",
        "expired"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e0\u05d5\u05db\u05d7\u05d9 \u05e9\u05dc \u05d4\u05d4\u05d8\u05d1\u05d4"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05e4\u05d5\u05d2\u05d4 \u05dc\u05d4\u05d8\u05d1\u05d4 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    }
  },
  "required": [
    "customer_id",
    "description",
    "type"
  ]
}