{
  "name": "DailyBrief",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05d4\u05ea\u05d0\u05e8\u05d9\u05da \u05d0\u05dc\u05d9\u05d5 \u05d4\u05d1\u05e8\u05d9\u05e3 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "lunch",
        "dinner"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05de\u05e8\u05ea (\u05e6\u05d4\u05e8\u05d9\u05d9\u05dd/\u05e2\u05e8\u05d1)"
    },
    "created_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d4\u05dc/\u05ea \u05e9\u05d9\u05e6\u05e8/\u05d4 \u05d0\u05ea \u05d4\u05d1\u05e8\u05d9\u05e3"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e8\u05d9\u05e3 (\u05d8\u05d9\u05d5\u05d8\u05d4/\u05e4\u05d5\u05e8\u05e1\u05dd)"
    },
    "sales_focus": {
      "type": "string",
      "description": "\u05d3\u05d2\u05e9 \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05dc\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "service_focus": {
      "type": "string",
      "description": "\u05d3\u05d2\u05e9 \u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "operational_focus": {
      "type": "string",
      "description": "\u05d3\u05d2\u05e9\u05d9\u05dd \u05d1\u05ea\u05e4\u05e2\u05d5\u05dc"
    },
    "story_of_the_day": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05d0\u05d5 \u05e1\u05d9\u05e4\u05d5\u05e8 \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "ai_summary": {
      "type": "string",
      "description": "\u05ea\u05e7\u05e6\u05d9\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d4\u05d1\u05e8\u05d9\u05e3 \u05e9\u05e0\u05d5\u05e6\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 AI"
    },
    "kitchen_shortages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d7\u05d5\u05e1\u05e8\u05d9\u05dd \u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd \u05de\u05d4\u05de\u05d8\u05d1\u05d7"
    },
    "bar_shortages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d7\u05d5\u05e1\u05e8\u05d9\u05dd \u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd \u05de\u05d4\u05d1\u05e8"
    },
    "sales_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_description": {
            "type": "string"
          },
          "target_value": {
            "type": "number"
          },
          "bonus_description": {
            "type": "string"
          }
        }
      },
      "description": "\u05d9\u05e2\u05d3\u05d9 \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d1\u05d5\u05e0\u05d5\u05e1"
    },
    "service_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_description": {
            "type": "string"
          }
        }
      },
      "description": "\u05d9\u05e2\u05d3\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "station_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "employee_name": {
            "type": "string"
          },
          "station_name": {
            "type": "string"
          }
        }
      },
      "description": "\u05d7\u05dc\u05d5\u05e7\u05d4 \u05dc\u05d0\u05d6\u05d5\u05e8\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea (\u05d0\u05d9\u05d5\u05e9\u05d5\u05ea)"
    },
    "closing_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_description": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          }
        }
      },
      "description": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e1\u05d2\u05d9\u05e8\u05d4 \u05de\u05d9\u05d5\u05d7\u05d3\u05d5\u05ea"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e2\u05e8\u05da \u05e9\u05dc employee_id \u05e9\u05dc \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05e9\u05e7\u05e8\u05d0\u05d5 \u05d0\u05ea \u05d4\u05d1\u05e8\u05d9\u05e3"
    }
  },
  "required": [
    "date",
    "shift_type"
  ]
}