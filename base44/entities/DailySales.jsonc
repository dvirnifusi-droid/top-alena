{
  "name": "DailySales",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "total_revenue": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05db\u05e0\u05e1\u05d5\u05ea"
    },
    "total_orders": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05de\u05e0\u05d5\u05ea"
    },
    "avg_order_value": {
      "type": "number",
      "description": "\u05e2\u05e8\u05da \u05d4\u05d6\u05de\u05e0\u05d4 \u05de\u05de\u05d5\u05e6\u05e2"
    },
    "food_sales": {
      "type": "number",
      "description": "\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05d0\u05d5\u05db\u05dc"
    },
    "beverage_sales": {
      "type": "number",
      "description": "\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05de\u05e9\u05e7\u05d0\u05d5\u05ea"
    },
    "alcohol_sales": {
      "type": "number",
      "description": "\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc"
    },
    "total_tips": {
      "type": "number",
      "description": "\u05e1\u05da \u05d8\u05d9\u05e4\u05d9\u05dd"
    },
    "covers": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d5\u05e2\u05d3\u05d9\u05dd"
    },
    "table_turnover": {
      "type": "number",
      "description": "\u05de\u05d7\u05d6\u05d5\u05e8 \u05e9\u05d5\u05dc\u05d7\u05e0\u05d5\u05ea"
    },
    "peak_hour": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05e9\u05d9\u05d0"
    },
    "weather": {
      "type": "string",
      "enum": [
        "sunny",
        "rainy",
        "cloudy",
        "stormy"
      ],
      "description": "\u05de\u05d6\u05d2 \u05d0\u05d5\u05d5\u05d9\u05e8"
    },
    "staff_count": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd"
    },
    "cost_of_goods": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05d7\u05d5\u05de\u05e8\u05d9 \u05d2\u05dc\u05dd"
    },
    "labor_cost": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05db\u05d7 \u05d0\u05d3\u05dd"
    },
    "profit_margin": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e8\u05d5\u05d5\u05d7"
    }
  },
  "required": [
    "date",
    "total_revenue",
    "total_orders"
  ]
}