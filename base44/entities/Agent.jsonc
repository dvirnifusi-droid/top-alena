{
  "name": "Agent",
  "type": "object",
  "properties": {
    "codename": {
      "type": "string",
      "description": "Unique agent codename, e.g. CEO, CFO, CRISIS, VP_MKT, SALES_CLOSER_EVENTS"
    },
    "role": {
      "type": "string",
      "enum": [
        "CEO",
        "EXECUTIVE",
        "VP",
        "UNIT_AGENT",
        "SUPPORT"
      ],
      "description": "Role tier within the CEO ecosystem"
    },
    "parent_agent_id": {
      "type": "string",
      "description": "Codename of the agent this one reports to (null for CEO)"
    },
    "status": {
      "type": "string",
      "enum": [
        "LIVE",
        "DORMANT",
        "FAILING"
      ],
      "default": "DORMANT",
      "description": "Current operational status"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the agent ran a cycle"
    },
    "system_prompt": {
      "type": "string",
      "description": "Full system prompt fed to InvokeLLM when the agent runs"
    },
    "model": {
      "type": "string",
      "description": "LLM model override, e.g. gemini-2.0-flash"
    },
    "config": {
      "type": "object",
      "description": "Per-agent params: thresholds, intervals, flags"
    }
  },
  "required": [
    "codename",
    "role"
  ]
}
