{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "start_time": {
      "type": "string",
      "format": "time",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_time": {
      "type": "string",
      "format": "time",
      "description": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd"
    },
    "guest_count": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d0\u05d5\u05e8\u05d7\u05d9\u05dd"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "birthday",
        "corporate",
        "wedding",
        "private",
        "live_music",
        "special_menu"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e8\u05d5\u0639"
    },
    "contact_person": {
      "type": "string",
      "description": "\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "\u05de\u05d9\u05d9\u05dc"
    },
    "menu_type": {
      "type": "string",
      "enum": [
        "regular",
        "fixed",
        "buffet",
        "cocktail"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05ea\u05e4\u05e8\u05d9\u05d8"
    },
    "budget_per_person": {
      "type": "number",
      "description": "\u05ea\u05e7\u05e6\u05d9\u05d1 \u05dc\u05d0\u05d3\u05dd"
    },
    "total_quote": {
      "type": "number",
      "description": "\u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8"
    },
    "deposit_paid": {
      "type": "number",
      "description": "\u05e4\u05d9\u05e7\u05d3\u05d5\u05df \u05e9\u05e9\u05d5\u05dc\u05dd"
    },
    "special_requirements": {
      "type": "string",
      "description": "\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05de\u05d9\u05d5\u05d7\u05d3\u05d5\u05ea"
    },
    "decorations": {
      "type": "string",
      "description": "\u05e2\u05d9\u05e6\u05d5\u05d1 \u05d5\u05d3\u05e7\u05d5\u05e8\u05e6\u05d9\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "inquiry",
        "quoted",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "inquiry"
    },
    "assigned_staff": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e6\u05d5\u05d5\u05ea \u05de\u05d5\u05e7\u05e6\u05d4"
    }
  },
  "required": [
    "name",
    "date",
    "guest_count",
    "contact_person",
    "phone"
  ]
}