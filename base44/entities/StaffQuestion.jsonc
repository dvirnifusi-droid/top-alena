{
  "name": "StaffQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d0\u05dc\u05d4 \u05e9\u05e0\u05e9\u05d0\u05dc\u05d4"
    },
    "answer": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e9\u05e0\u05d9\u05ea\u05e0\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "asked_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e9\u05d0\u05dc"
    },
    "satisfaction_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05e9\u05d1\u05d9\u05e2\u05d5\u05ea \u05e8\u05e6\u05d5\u05df \u05de\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "was_helpful": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05de\u05d5\u05e2\u05d9\u05dc\u05d4"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05de\u05e2\u05e7\u05d1"
    }
  },
  "required": [
    "question",
    "answer",
    "asked_by"
  ]
}