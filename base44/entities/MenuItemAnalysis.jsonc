{
  "name": "MenuItemAnalysis",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05de\u05e0\u05d4"
    },
    "total_sold": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05db\u05d5\u05dc\u05dc\u05ea \u05e9\u05e0\u05de\u05db\u05e8\u05d4"
    },
    "sales_trend": {
      "type": "string",
      "enum": [
        "rising",
        "stable",
        "declining",
        "seasonal"
      ],
      "description": "\u05de\u05d2\u05de\u05ea \u05de\u05db\u05d9\u05e8\u05d5\u05ea"
    },
    "popularity_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05d5\u05ea (0-100)"
    },
    "profit_margin": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e8\u05d5\u05d5\u05d7 \u05de\u05d4\u05de\u05e0\u05d4"
    },
    "recommended_prep_quantity": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05d4\u05db\u05e0\u05d4 \u05de\u05d5\u05de\u05dc\u05e6\u05ea"
    },
    "ingredients_to_stock": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient": {
            "type": "string"
          },
          "quantity_needed": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "description": "\u05d7\u05d5\u05de\u05e8\u05d9 \u05d2\u05dc\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05de\u05dc\u05d0\u05d9"
    },
    "peak_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d9\u05de\u05d9\u05dd \u05d1\u05d4\u05dd \u05d4\u05de\u05e0\u05d4 \u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3"
    },
    "analysis_period": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e0\u05d9\u05ea\u05d5\u05d7"
    }
  },
  "required": [
    "item_name",
    "total_sold",
    "popularity_score"
  ]
}