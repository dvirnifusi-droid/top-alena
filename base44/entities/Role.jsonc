{
  "name": "Role",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "view_dashboard",
          "manage_employees",
          "manage_training",
          "manage_incidents",
          "manage_suppliers",
          "view_reports",
          "admin"
        ]
      },
      "description": "\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "level": {
      "type": "string",
      "enum": [
        "junior",
        "senior",
        "manager",
        "director",
        "admin"
      ],
      "description": "\u05e8\u05de\u05ea \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "name",
    "level"
  ]
}