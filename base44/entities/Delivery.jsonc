{
  "name": "Delivery",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "cash_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d1\u05de\u05d6\u05d5\u05de\u05df"
    },
    "credit_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d1\u05d0\u05e9\u05e8\u05d0\u05d9"
    },
    "total_delivery_amount": {
      "type": "number",
      "description": "\u05e1\u05d4\"\u05db \u05de\u05e9\u05dc\u05d5\u05d7 (\u05db\u05d5\u05dc\u05dc \u05d3\u05de\u05d9 \u05de\u05e9\u05dc\u05d5\u05d7)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "unpaid"
      ],
      "default": "unpaid",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "courier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05dc\u05d9\u05d7 \u05e9\u05dc\u05e7\u05d7 \u05d0\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "opened_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3 \u05e9\u05e4\u05ea\u05d7/\u05e8\u05e9\u05dd \u05d0\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05d1\u05de\u05e2\u05e8\u05db\u05ea"
    },
    "photo_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05ea\u05e7 \u05d4\u05de\u05e9\u05dc\u05d5\u05d7"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Wolt",
        "\u05ea\u05df \u05d1\u05d9\u05e1",
        "\u05e1\u05d9\u05d1\u05d5\u05e1",
        "Mishloha",
        "Valuecard",
        "\u05d8\u05dc\u05e4\u05d5\u05df"
      ],
      "description": "\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "items_ordered": {
      "type": "string",
      "description": "\u05e4\u05d9\u05e8\u05d5\u05d8 \u05e4\u05e8\u05d9\u05d8\u05d9 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "neighborhood": {
      "type": "string",
      "description": "\u05e9\u05db\u05d5\u05e0\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "delayed",
        "compensation_needed",
        "wrong_address",
        "wrong_order",
        "customer_complaint",
        "damaged",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d1\u05e2\u05d9\u05d4"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "picked_up",
        "delivered"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 - \u05de\u05de\u05ea\u05d9\u05df/\u05d1\u05d3\u05e8\u05da/\u05d4\u05d5\u05e8\u05d9\u05d3"
    },
    "picked_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05e8\u05de\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e9\u05dc\u05d9\u05d7"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05d4\u05d5\u05e8\u05d3\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e9\u05dc\u05d9\u05d7"
    }
  },
  "required": [
    "date",
    "address",
    "cash_amount"
  ]
}