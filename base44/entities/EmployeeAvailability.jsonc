{
  "name": "EmployeeAvailability",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "employee_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "availability_type": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "partial",
        "preferred_off"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05ea"
    },
    "shift_preference": {
      "type": "string",
      "enum": [
        "lunch",
        "dinner",
        "both"
      ],
      "default": "both",
      "description": "\u05d4\u05e2\u05d3\u05e4\u05ea \u05de\u05e9\u05de\u05e8\u05ea"
    },
    "available_from": {
      "type": "string",
      "format": "time",
      "description": "\u05d6\u05de\u05d9\u05df \u05de\u05d4\u05e9\u05e2\u05d4 (\u05d0\u05dd \u05d7\u05dc\u05e7\u05d9)"
    },
    "available_until": {
      "type": "string",
      "format": "time",
      "description": "\u05d6\u05de\u05d9\u05df \u05e2\u05d3 \u05d4\u05e9\u05e2\u05d4 (\u05d0\u05dd \u05d7\u05dc\u05e7\u05d9)"
    },
    "reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05d4 \u05dc\u05d0\u05d9 \u05d6\u05de\u05d9\u05e0\u05d5\u05ea"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05e9\u05d4\u05e2\u05d5\u05d1\u05d3 \u05d9\u05db\u05d5\u05dc \u05dc\u05de\u05dc\u05d0"
    },
    "admin_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05e0\u05d4\u05dc \u05d1\u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05ea"
    },
    "department": {
      "type": "string",
      "enum": [
        "floor",
        "kitchen"
      ],
      "description": "\u05d4\u05d7\u05d8\u05d9\u05d1\u05d4 \u05e9\u05d1\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3 \u05d4\u05d2\u05d9\u05e9 \u05d6\u05de\u05d9\u05e0\u05d5\u05ea"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "date",
    "availability_type"
  ]
}