{
  "name": "Apparel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8 (\u05dc\u05de\u05e9\u05dc: \u05db\u05d5\u05d1\u05e2 \u05d6\u05d4\u05d1, \u05d2\u05dc\u05d9\u05de\u05d4 \u05e9\u05d7\u05d5\u05e8\u05d4)"
    },
    "category": {
      "type": "string",
      "enum": [
        "shirt",
        "pants",
        "shoes",
        "hat",
        "accessory",
        "outerwear"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05dc\u05d1\u05d5\u05e9"
    },
    "cost": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d1\u05de\u05d8\u05d1\u05e2\u05d5\u05ea"
    },
    "emoji": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d5\u05d2'\u05d9 \u05e9\u05de\u05d9\u05d9\u05e6\u05d2 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "wearing_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05dc\u05e4\u05e8\u05d5\u05de\u05e4\u05d8 AI (\u05dc\u05de\u05e9\u05dc: 'wearing a golden chef hat')"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8 \u05d6\u05de\u05d9\u05df \u05dc\u05e7\u05e0\u05d9\u05d9\u05d4"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary"
      ],
      "default": "common",
      "description": "\u05e8\u05de\u05ea \u05e0\u05d3\u05d9\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "category",
    "cost",
    "wearing_text"
  ]
}