{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05e8\u05d9\u05d8"
    },
    "category": {
      "type": "string",
      "enum": [
        "meat",
        "vegetables",
        "dairy",
        "beverages",
        "alcohol",
        "dry_goods",
        "cleaning",
        "disposables"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05d4"
    },
    "current_stock": {
      "type": "number",
      "description": "\u05de\u05dc\u05d0\u05d9 \u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "liters",
        "pieces",
        "packages",
        "bottles"
      ],
      "description": "\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d9\u05d3\u05d4"
    },
    "min_threshold": {
      "type": "number",
      "description": "\u05e8\u05de\u05ea \u05de\u05dc\u05d0\u05d9 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea"
    },
    "max_capacity": {
      "type": "number",
      "description": "\u05e7\u05d9\u05d1\u05d5\u05dc\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "\u05e2\u05dc\u05d5\u05ea \u05dc\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e4\u05e7"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05e4\u05d5\u05d2\u05d4"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05de\u05dc\u05d0\u05d9"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "reorder_quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05dc\u05d4\u05d6\u05de\u05e0\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea"
    }
  },
  "required": [
    "item_name",
    "category",
    "current_stock",
    "unit",
    "cost_per_unit"
  ]
}