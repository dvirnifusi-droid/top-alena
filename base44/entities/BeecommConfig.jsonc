{
  "name": "BeecommConfig",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05dc\u05e7\u05d5\u05d7 \u05de-Beecomm"
    },
    "client_secret": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d3 \u05dc\u05e7\u05d5\u05d7 \u05de-Beecomm"
    },
    "access_token": {
      "type": "string",
      "description": "\u05d8\u05d5\u05e7\u05df \u05d2\u05d9\u05e9\u05d4 \u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "token_expires": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d6\u05de\u05df \u05ea\u05e4\u05d5\u05d2\u05ea \u05d4\u05d8\u05d5\u05e7\u05df"
    },
    "api_base_url": {
      "type": "string",
      "default": "https://biapp.beecomm.co.il:8094",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d1\u05e1\u05d9\u05e1 \u05e9\u05dc API"
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "client_id",
    "client_secret"
  ]
}