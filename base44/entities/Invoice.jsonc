{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e4\u05e7"
    },
    "invoice_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "total_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05db\u05d5\u05dc\u05dc"
    },
    "file_url": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05e7\u05d5\u05d1\u05e5 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d4\u05e1\u05e8\u05d5\u05e7\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "processed",
        "error"
      ],
      "default": "pending_review"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e9\u05dc\u05d5\u05dd \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    }
  },
  "required": [
    "supplier_id",
    "invoice_date",
    "total_amount"
  ]
}