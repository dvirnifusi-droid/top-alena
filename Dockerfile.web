# Serves the PREBUILT frontend bundle from dist/.
#
# Why no build stage: the 2GB Hetzner VPS OOMs running `vite build` (bundle
# grew past 4MB), which silently froze frontend deploys — the API kept
# updating while web served a stale image. Since 2026-06-11 the workflow is:
#
#   1. Build locally:  npx vite build   (uses .env.production.local for
#      VITE_API_BASE_URL=/api + Google client ID + VAPID public key)
#   2. Commit dist/ together with the source changes
#   3. Push → server cron copies dist into this nginx image (seconds, no RAM)
#
# IMPORTANT: a frontend change without a fresh committed dist/ will deploy
# stale UI. Always run vite build before pushing frontend changes.
# Force-rebuild trigger: touched 2026-07-01 to recover from an autodeploy
# race where the api rebuild failed and left web stale.
FROM nginx:1.27-alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
