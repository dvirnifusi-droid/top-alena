# Replace example.com with your real domain to get automatic HTTPS.
# For local dev, use `:80` instead.

{$DOMAIN:localhost} {
    # Cloudflare (proxied) terminates public TLS with a trusted cert and
    # connects here over HTTPS in "Full" mode, which accepts a self-signed
    # origin cert. We use a STATIC wildcard cert on disk (generated once
    # by scripts/ensure-wildcard-cert.sh) instead of `tls internal` because
    # tls internal was silently failing to provision certs for newly-added
    # tenant hostnames after `caddy reload`, causing every new signup to
    # bounce with Cloudflare 525 SSL handshake failed. Static cert = zero
    # on-demand race; every tenant's *.topalena.com resolves instantly.
    tls /etc/caddy/certs/wildcard.crt /etc/caddy/certs/wildcard.key
    @api path /api/*
    handle @api {
        reverse_proxy api:3001
    }
    handle {
        reverse_proxy web:80
    }
    encode gzip
}

# Fallback for unknown *.topalena.com subdomains — someone typed a slug
# that doesn't have a Caddyfile block yet (either the tenant's block
# hasn't been appended yet, or they made up a name). Better UX than
# a blank page: redirect them to the main site's signup page so if they
# were trying to find their own restaurant, they can create it.
# NOTE: real tenants' blocks are appended AFTER this fallback by
# sync-tenant-caddy.sh, but Caddy matches HOSTNAME-specific blocks
# BEFORE wildcards, so real tenants aren't affected.
*.topalena.com {
    tls /etc/caddy/certs/wildcard.crt /etc/caddy/certs/wildcard.key
    redir https://topalena.com/Signup 302
}
