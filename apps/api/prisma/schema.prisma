  raw                 Json?      // full pos object for future fields we haven't broken out

  createdAt           DateTime @default(now())

  @@index([pos_id, captured_at])
}

// Historical day-level Beecomm data. One row per IL calendar date per POS.
// Populated by the backfill job which calls /api/z/summary + /api/dishes
