  open_money          Float?
  predicted_month     Float?
  predicted_year      Float?
  online_shifts       Int?
  active_today        Boolean?
  beecomm_last_update_x       BigInt?
  beecomm_last_update_z       BigInt?
  beecomm_last_update_dishes  BigInt?
  beecomm_last_update_shifts  BigInt?
  // Rich JSON blobs for the widget + future analytics
  workers             Json?      // [{ workerId, name, diners, sum, tips }]
  top_dishes          Json?      // [{ dishId, name, categoryName, quantity, sum }]
  payments            Json?      // { paymentTypeName: { sum, hiuv, zikuy, tips } }
  orders_by_hour      Json?
