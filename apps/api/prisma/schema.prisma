// Snapshot of Gomiley /system/pages/orders/ajax.php response — captured by
// a cron every 5 minutes so we have a live mirror of today's delivery
// orders: per-source breakdown (Wolt, Bolt, 10bis, ישיר), payment method
// (cash/credit detected from order receipt), totals, hourly distribution.
// Drives the GomileyLiveWidget on the home dashboard.
model GomileySnapshot {
  id                  String   @id @default(cuid())
  restaurant_id       String   // Gomiley restaurant id (1968 for עלינא)
  captured_at         DateTime @default(now())
  // Top-level totals from ajax.php response
  total_income        Float?
  total_orders        Int?
  new_orders          Int?
  cancelled_orders    Int?
  split_orders        Int?
  cross_min_orders    Int?
  // Derived per-source rollups (computed from orders[])
  cash_orders_count   Int?     @default(0)
  cash_orders_amount  Float?   @default(0)
  // Raw + parsed orders for the widget (each order: id, guid, customer,
  // source, amount, delivery_at, status, courier, payment_method)
  orders              Json?
  raw                 Json?    // entire response for debugging
  createdAt           DateTime @default(now())

  @@index([restaurant_id, captured_at])
}

// Snapshot of Gomiley dashboard page (/system/pages/index/) — HTML scrape that
