  createdAt             DateTime @default(now())

  @@index([restaurant_id, captured_at])
}

// Snapshot of Beecomm /api/auth/<uid> response — captured by a cron every
// 15 minutes so we have a live mirror of today's POS data: per-waiter sales,
// hourly orders, top dishes, payment breakdown, predicted month/year.
// Drives the AdminLiveBeecommWidget on the home dashboard and feeds future
// auto-credit into the Sales Gamification system.
model BeecommSnapshot {
  id                  String   @id @default(cuid())
  pos_id              String
