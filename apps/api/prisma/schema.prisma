  landing_url                  String?  // full URL the customer landed on
  referrer                     String?  // document.referrer captured at booking time
  // Hostess-side bookkeeping — small per-reservation flag the hostess sets
  // via a single click. Values: 'green' (called, confirmed) / 'orange' (called,
  // running late) / 'red' (called, no answer) / 'black' (problem customer).
  hostess_flag                 String?
  // Customer-facing tracking token. Random 28-char string. URL becomes
  // /ReservationView?token=<>. Lets the customer cancel / view their own
  // reservation without auth.
  tracking_token               String?  @unique
  customer_email               String?
  // Marketing consent — explicit opt-in checkbox in the public form.
  // Required by Israeli Spam Law (Section 30A) for any non-transactional message.
  // Transactional (booking confirm, table-ready, etc.) does NOT depend on this.
  marketing_consent            Boolean  @default(false)
  marketing_consent_at         DateTime?
  cancelled_at                 DateTime?
  cancellation_reason          String?
  deposit_charged_at           DateTime?
  deposit_charge_amount        Int?     // in ILS
  // Deposit / auth-hold flow (new). The hold is created at booking time, then either:
  // - released on arrival (auto when status→seated)
  // - captured if no_show (auto after a grace period, or manual by hostess)
  deposit_required             Boolean  @default(false)
  deposit_amount               Int?     // requested hold amount in ILS
  deposit_provider             String?  // 'max_online' | 'tranzila' | 'payplus' | 'cardcom' (set after we know which)
  deposit_provider_ref         String?  // transaction id at the provider
  deposit_status               String?  // 'pending' | 'authorized' | 'captured' | 'released' | 'failed'
  deposit_authorized_at        DateTime?
  deposit_released_at          DateTime?
  // Standby waitlist — guest opted in when their preferred slot was full.
  // is_standby=true means restaurant promised to call back if a real table
  // opens. On callback the hostess flips this to false (= promoted to real).
  is_standby                   Boolean  @default(false)
  standby_requested_time       String?  // the time they originally wanted (HH:mm)
  standby_promoted_at          DateTime?
  // T+24h survey ping — once we WhatsApp the customer a feedback link we
  // stamp this so the daily cron never pings the same person twice.
  survey_sent_at               DateTime?
  // Legacy base44 columns — exist in DB; declared so frontend code that
  // reads record.created_date / record.updated_date still gets a value.
  created_date String?
  updated_date String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Owner-editable marketing popup shown on /PublicReservation.
// One popup is picked per session at mount time, based on day/hour filters
// + priority. Edits go through /SpecialsAdmin so no code push is needed
// to swap copy or run a one-off campaign.
model SpecialPopup {
  id                String   @id @default(cuid())
  variant           String   @unique   // stable key: 'events', 'lunch', 'midweek-1', etc.
  eyebrow           String?
  emoji             String?
  title             String
  body              String
  cta               String   @default("הזמן שולחן")
  cta_href          String?  // null = scroll to #booking; full URL/path = navigate
  // Targeting: CSV of day numbers ('0,1,2,3,4,5,6') — null/empty = any day.
  target_days       String?
  target_hour_from  Int?     // 0-23 inclusive — null = any
  target_hour_to    Int?     // 0-23 exclusive — null = any
  // Higher priority wins ties when multiple popups match the current moment.
  priority          Int      @default(0)
  is_active         Boolean  @default(true)
  // Optional one-shot scheduling — popup only appears between these dates.
  starts_at         DateTime?
  ends_at           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// DepositSettings — singleton row that defines when a deposit is required,
// how much to charge, and the no-charge cancellation window.
model DepositSettings {
  id                              String   @id @default(cuid())
  singleton                       Boolean  @unique @default(true)
  // Rules — JSON: { weekend_days: ['thursday','friday','saturday'], min_party_for_midweek: 6 }
  required_weekend_days           Json?
  required_midweek_min_party_size Int?     @default(6)
  // Amounts
  amount_per_guest_ils            Int?     @default(30) // ₪30 per guest
  event_pct                       Int?     @default(20) // 20% of event value
  // Cancellation policy — free-cancel cutoffs (in hours before reservation)
  free_cancel_hours_small         Int?     @default(3)  // up to 6 guests
  free_cancel_hours_large         Int?     @default(6)  // 6+ guests
  free_cancel_hours_event         Int?     @default(24) // events 13+
  small_party_threshold           Int?     @default(6)  // up to this many = "small"
  // Provider — set by owner after they pick (max_online / tranzila / payplus / cardcom)
  provider                        String?
  provider_credentials            Json?    // encrypted/opaque; set via admin panel
  // Master switch
  enabled                         Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

// Conversion-funnel telemetry for SpecialPopup. Each event ties back to a
// session (sessionStorage UUID generated client-side) so we can compute
// per-variant: impressions, dismissal rate, click-through, and conversion
// (= reservation succeeded in the same session after a click).
model PopupEvent {
  id        String   @id @default(cuid())
  variant   String   // matches SpecialPopup.variant
  action    String   // 'shown' | 'dismissed' | 'clicked' | 'converted'
  sessionId String
  ts        DateTime @default(now())
  @@index([variant, action])
  @@index([sessionId])
}

