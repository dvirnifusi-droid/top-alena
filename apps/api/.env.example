# --- Core ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/topalena?schema=public

# --- Auth ---
JWT_SECRET=replace-me-with-long-random-string
JWT_EXPIRES_IN=7d

# --- Object Storage (MinIO / S3 / R2) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=top-alena
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/top-alena

# --- LLM ---
GEMINI_API_KEY=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Pushover ---
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=

# --- Instagram ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
